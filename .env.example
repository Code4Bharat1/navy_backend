# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# MongoDB — must be a replica set (even a single-node one), not standalone, because
# the wallet ledger uses multi-document transactions. `docker compose up -d` gives you
# this on port 27017. If that port is already taken by another local MongoDB install
# (e.g. a plain standalone Windows/Mac service), run a second instance on a different
# port instead of trying to share that one — see README "Why a replica set for local Mongo".
MONGO_URI=mongodb://localhost:27017/navy_cashless?replicaSet=rs0

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=100h

# Razorpay Payment Gateway (recharge-in), for the pooled/nodal account.
# Get these from the Razorpay Dashboard (Settings > API Keys). Use test mode keys
# (rzp_test_...) until the account is live.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
# Settings > Webhooks > create one pointing at POST /api/recharge/razorpay/webhook,
# subscribed to the "payment.captured" event. Copy its signing secret here.
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
