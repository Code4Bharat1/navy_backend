# Server
PORT=4000
NODE_ENV=development
# Allowed CORS origins are hardcoded in backend/src/config/env.js (clientOrigins),
# not read from env — edit that file directly to change them.

# MongoDB — must be a replica set (even a single-node one), not standalone, because
# the wallet ledger uses multi-document transactions. `pm2 start ecosystem.config.js`
# (project root) gives you this via the "navy-mongo" app on port 27018 — see README
# "Why a replica set for local Mongo". If you'd rather point at a MongoDB you already
# have running with replication enabled, change this to match its port/URI instead.
MONGO_URI=mongodb://localhost:27018/navy_cashless?replicaSet=rs0

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=100h

# Razorpay Payment Gateway (recharge-in), for the pooled/nodal account.
# Get these from the Razorpay Dashboard (Settings > API Keys). Use test mode keys
# (rzp_test_...) until the account is live.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
# Settings > Webhooks > create one pointing at POST /api/recharge/razorpay/webhook,
# subscribed to the "payment.captured" event. Copy its signing secret here.
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# RazorpayX Payouts (settlement-out to shop bank accounts). This is a SEPARATE product
# from the Payment Gateway above and needs its own business/current account with
# RazorpayX enabled — different keys, different dashboard section.
RAZORPAYX_KEY_ID=YOUR_RAZORPAYX_KEY_ID
RAZORPAYX_KEY_SECRET=YOUR_RAZORPAYX_KEY_SECRET
# The virtual account payouts are debited from (RazorpayX Dashboard > Accounts).
RAZORPAYX_ACCOUNT_NUMBER=YOUR_RAZORPAYX_VIRTUAL_ACCOUNT_NUMBER

# Settlement engine
# Cron expression for the automatic daily settlement run (default: 2 AM server time).
SETTLEMENT_CRON=0 2 * * *
# Set to "false" to disable the automatic run entirely (manual "Run settlement" only).
SETTLEMENT_CRON_ENABLED=true

# Optional: first Super Admin created by `npm run seed:admin`. Falls back to
# admin@navycashless.local / ChangeMe123! if unset — change the password either way.
SEED_ADMIN_EMAIL=admin@navycashless.local
SEED_ADMIN_PASSWORD=ChangeMe123!
