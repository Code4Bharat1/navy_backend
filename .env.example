# Server
PORT=4000
NODE_ENV=development
# Allowed CORS origins are hardcoded in backend/src/config/env.js (clientOrigins),
# not read from env — edit that file directly to change them.

# MongoDB — must be a replica set (even a single-node one), not standalone, because
# the wallet ledger uses multi-document transactions. `pm2 start ecosystem.config.js`
# (project root) gives you this via the "navy-mongo" app on port 27018 — see README
# "Why a replica set for local Mongo". If you'd rather point at a MongoDB you already
# have running with replication enabled (e.g. an Atlas cluster, always a replica set
# by default), change this to match its URI instead.
MONGO_URI=mongodb://localhost:27018/navy_cashless?replicaSet=rs0

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=100h

# Optional: first Super Admin created by `npm run seed:admin`. Falls back to
# admin@navycashless.local / ChangeMe123! if unset — change the password either way.
SEED_ADMIN_EMAIL=admin@navycashless.local
SEED_ADMIN_PASSWORD=ChangeMe123!
